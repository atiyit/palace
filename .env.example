# ═══════════════════════════════════════════════════════════════
# 偏爱 · Palace — 环境变量参考
# ═══════════════════════════════════════════════════════════════
#
# 主人请注意：这份文件是历史托管 / 预览环境的配置参考。
# 本地使用 npm start 启动时不会自动读取 .env 文件。
# 日常 API 配置请在浏览器的「庭院设置」界面中填写。
#
# PORT 和 PALACE_DATA_DIR 作为进程环境变量控制本地启动，
# 未设置 PORT 时，PALACE_PORT 也可作为端口后备。
# 需要时在终端中直接设置即可，无需写入此文件。
#
# 请勿在此处填写真实密钥或真实 API 地址。
# ═══════════════════════════════════════════════════════════════

# --- 文本模型（历史托管参考） ---
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- 图片模型（历史托管参考） ---
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=

# --- 渠道设置加密（历史托管参考） ---
PROVIDER_SETTINGS_SECRET=

# --- 预览环境（历史托管参考） ---
PALACE_PREVIEW_LLM_KEY=
PALACE_PREVIEW_SETTINGS_SECRET=
